rules_version = '2';

// Stag Planner Firestore security rules.
//
// Tree:
//   stagEvents/{eventId}
//     /members/{memberId}
//     /destinations/{id}/{votes,comments,prosCons}
//     /ideas/{id}/{votes,comments,prosCons}
//     /tasks/{id}/{comments,subtasks}
//     /decisions/{id}/{comments,options/{id}/{votes,prosCons}}
//     /activityLog/{id}
//
// Visibility:
//   private events → reads require membership
//   public events  → reads open to anyone
//   writes always require membership
//
// Voting: vote doc id == userId. Two writes from the same user can't create
// two docs.
//
// Counters: members may freely update parent docs (commentCount, voteCount,
// optionCount, subtaskTotal, subtaskCompleted) — the app maintains them via
// transactions. We don't try to enforce delta correctness in rules (that
// would require complex resource.data math).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function self(uid) { return request.auth.uid == uid; }
    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/stagEvents/$(eventId)).data;
    }
    function isPublic(eventId) { return eventDoc(eventId).visibility == "public"; }
    function isMember(eventId) {
      return signedIn() && request.auth.uid in eventDoc(eventId).memberIds;
    }
    function isOrganiser(eventId) {
      return signedIn() && eventDoc(eventId).organiserId == request.auth.uid;
    }
    function canRead(eventId) { return isMember(eventId) || isPublic(eventId); }

    // --- Users ----------------------------------------------------------------
    match /users/{uid} {
      allow read: if true;
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'avatarUrl', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow update: if self(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl']);
      allow delete: if false;
    }

    // --- Events ---------------------------------------------------------------
    match /stagEvents/{eventId} {
      allow read: if request.auth.uid in resource.data.memberIds
        || resource.data.visibility == "public";

      allow create: if signedIn()
        && request.resource.data.organiserId == request.auth.uid
        && request.resource.data.memberIds.hasAll([request.auth.uid])
        && request.resource.data.memberIds.size() == 1;

      allow update: if signedIn() && (
        resource.data.organiserId == request.auth.uid
        // Self-join on a public event: only memberIds may change, by +1 with the caller.
        || (
          resource.data.visibility == "public"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        )
      );

      allow delete: if signedIn() && resource.data.organiserId == request.auth.uid;

      // --- Members --------------------------------------------------------
      match /members/{memberId} {
        allow read: if canRead(eventId);
        allow create: if signedIn() && (
          isOrganiser(eventId)
          || (request.resource.data.userId == request.auth.uid && isPublic(eventId))
          || (request.resource.data.userId == request.auth.uid
              && eventDoc(eventId).organiserId == request.auth.uid)
        );
        allow update: if signedIn() && isOrganiser(eventId);
        allow delete: if signedIn() && (
          isOrganiser(eventId) || resource.data.userId == request.auth.uid
        );
      }

      // --- Destinations ---------------------------------------------------
      match /destinations/{id} {
        allow read: if canRead(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.voteCount == 0
          && request.resource.data.commentCount == 0;
        allow update: if isMember(eventId);
        allow delete: if isMember(eventId) && (
          resource.data.createdBy == request.auth.uid || isOrganiser(eventId)
        );

        match /votes/{userId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId) && self(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.value == 1;
          allow update: if false;
          allow delete: if isMember(eventId) && self(userId);
        }

        match /comments/{commentId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.userId == request.auth.uid;
          allow update: if false;
          allow delete: if isMember(eventId) && (
            resource.data.userId == request.auth.uid || isOrganiser(eventId)
          );
        }

        match /prosCons/{itemId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.userId == request.auth.uid
            && (request.resource.data.type == "pro" || request.resource.data.type == "con");
          allow update: if false;
          allow delete: if isMember(eventId) && (
            resource.data.userId == request.auth.uid || isOrganiser(eventId)
          );
        }
      }

      // --- Ideas ----------------------------------------------------------
      match /ideas/{id} {
        allow read: if canRead(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.voteCount == 0
          && request.resource.data.commentCount == 0;
        allow update: if isMember(eventId);
        allow delete: if isMember(eventId) && (
          resource.data.createdBy == request.auth.uid || isOrganiser(eventId)
        );

        match /votes/{userId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId) && self(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.value == 1;
          allow update: if false;
          allow delete: if isMember(eventId) && self(userId);
        }

        match /comments/{commentId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.userId == request.auth.uid;
          allow update: if false;
          allow delete: if isMember(eventId) && (
            resource.data.userId == request.auth.uid || isOrganiser(eventId)
          );
        }

        match /prosCons/{itemId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.userId == request.auth.uid
            && (request.resource.data.type == "pro" || request.resource.data.type == "con");
          allow update: if false;
          allow delete: if isMember(eventId) && (
            resource.data.userId == request.auth.uid || isOrganiser(eventId)
          );
        }
      }

      // --- Tasks ----------------------------------------------------------
      match /tasks/{id} {
        allow read: if canRead(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.commentCount == 0
          && request.resource.data.subtaskTotal == 0
          && request.resource.data.subtaskCompleted == 0;
        allow update: if isMember(eventId);
        allow delete: if isMember(eventId) && (
          resource.data.createdBy == request.auth.uid
          || resource.data.assigneeId == request.auth.uid
          || isOrganiser(eventId)
        );

        match /comments/{commentId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.userId == request.auth.uid;
          allow update: if false;
          allow delete: if isMember(eventId) && (
            resource.data.userId == request.auth.uid || isOrganiser(eventId)
          );
        }

        match /subtasks/{subtaskId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.completed == false;
          allow update: if isMember(eventId);
          allow delete: if isMember(eventId);
        }
      }

      // --- Decisions ------------------------------------------------------
      match /decisions/{id} {
        allow read: if canRead(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.optionCount == 0
          && request.resource.data.commentCount == 0
          && request.resource.data.chosenOptionId == null;
        // Only organiser can finalise the chosen option. Members may edit
        // anything else (status, description, options).
        allow update: if isMember(eventId) && (
          isOrganiser(eventId)
          || (
            // Members can update fields *other than* chosenOptionId/Text.
            !('chosenOptionId' in request.resource.data.diff(resource.data).affectedKeys())
            && !('chosenOptionText' in request.resource.data.diff(resource.data).affectedKeys())
          )
        );
        allow delete: if isMember(eventId) && (
          resource.data.createdBy == request.auth.uid || isOrganiser(eventId)
        );

        match /comments/{commentId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.userId == request.auth.uid;
          allow update: if false;
          allow delete: if isMember(eventId) && (
            resource.data.userId == request.auth.uid || isOrganiser(eventId)
          );
        }

        match /options/{optionId} {
          allow read: if canRead(eventId);
          allow create: if isMember(eventId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.voteCount == 0;
          allow update: if isMember(eventId);
          allow delete: if isMember(eventId) && (
            resource.data.createdBy == request.auth.uid || isOrganiser(eventId)
          );

          match /votes/{userId} {
            allow read: if canRead(eventId);
            allow create: if isMember(eventId) && self(userId)
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.value == 1;
            allow update: if false;
            allow delete: if isMember(eventId) && self(userId);
          }

          match /prosCons/{itemId} {
            allow read: if canRead(eventId);
            allow create: if isMember(eventId)
              && request.resource.data.userId == request.auth.uid
              && (request.resource.data.type == "pro" || request.resource.data.type == "con");
            allow update: if false;
            allow delete: if isMember(eventId) && (
              resource.data.userId == request.auth.uid || isOrganiser(eventId)
            );
          }
        }
      }

      // --- Activity log ---------------------------------------------------
      match /activityLog/{entryId} {
        allow read: if canRead(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && isOrganiser(eventId);
      }
    }

    // --- Global admin activity log -------------------------------------------
    // Only the Admin SDK (server) writes here; clients are never permitted
    // read or write access. Bypassing rules requires service-account creds.
    match /adminActivityLog/{entryId} {
      allow read, write: if false;
    }
  }
}
