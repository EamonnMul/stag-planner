# Copy to .env.local and fill in values from your Firebase project console.
# Project settings > General > Your apps > Web app SDK config.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Admin / server-side ---
#
# Used by /api/admin/* routes (Firebase Admin SDK). NEVER expose these to
# the client — they grant full project access.
#
# Pick ONE option:
#
# Option A: a single JSON blob (the entire service-account.json file).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#
# Option B: three separate vars (escape \n in the private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated emails that bootstrap as admin even without the custom
# claim. Use to seed the FIRST admin on a fresh deploy. Once that admin
# grants themselves the claim through /admin, the env var is optional.
INITIAL_ADMIN_EMAILS=

# For seed script only (path to a service-account.json).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
